<Window x:Class="CCSBar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCS Bar" Width="360" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Effect="{DynamicResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MaxHeight="760"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/HeaderLogo.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/><StackPanel><TextBlock Text="CCS Bar" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CcsButton.FooterIcon}" Content="↻" FontSize="18" ToolTip="Force refresh" AutomationProperties.Name="Force refresh CCS data" Click="Refresh_Click"/>
            </Grid>
            <Separator Grid.Row="1"/>
            <Grid Grid.Row="2">
                <StackPanel x:Name="OfflinePanel" Margin="18,26" Visibility="Collapsed"><TextBlock x:Name="OfflineTitle" Text="CCS is not running" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="OfflineBody" Text="Start CCS, then panel connects automatically." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="StartButton" Style="{StaticResource CcsButton.Primary}" Content="Start CCS" Click="Start_Click" AutomationProperties.Name="Start CCS server"/><Button x:Name="RetryButton" Style="{StaticResource CcsButton.Secondary}" Content="Retry" Click="Retry_Click" AutomationProperties.Name="Retry connection without starting server"/></StackPanel></StackPanel>
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContentPanel" Margin="14,12"/></ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource CcsButton.FooterIcon}" Content="Dashboard" Click="Dashboard_Click" AutomationProperties.Name="Open CCS Dashboard"/><Button Style="{StaticResource CcsButton.FooterIcon}" Content="Settings" Click="Settings_Click" AutomationProperties.Name="Open CCS Bar settings"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="StatusText" Width="1" Height="1" Opacity="0" AutomationProperties.LiveSetting="Polite"/><Button x:Name="UpdateButton" Style="{StaticResource CcsButton.FooterIcon}" Content="Update" Visibility="Collapsed" Click="Update_Click" AutomationProperties.Name="Install update"/><Button Style="{StaticResource CcsButton.FooterIcon}" Content="▥" ToolTip="Toggle chart style" AutomationProperties.Name="Toggle chart style" Click="Chart_Click"/><Button Style="{StaticResource CcsButton.FooterIcon}" Content="↻" ToolTip="Refresh" AutomationProperties.Name="Refresh CCS data" Click="Refresh_Click"/><Button x:Name="QuitButton" Style="{StaticResource CcsButton.FooterIcon}" Content="Power" ToolTip="Quit CCS Bar (click again to confirm)" AutomationProperties.Name="Quit CCS Bar" Click="Quit_Click"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
