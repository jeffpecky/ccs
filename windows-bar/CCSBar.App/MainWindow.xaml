<Window x:Class="CCSBar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCS Bar" Width="360" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Effect="{DynamicResource PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Grid.Row="0" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Source="/Assets/HeaderLogo.png" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="CCS" FontSize="13" FontWeight="SemiBold" LineHeight="14"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="usage &amp; accounts" FontSize="10" Foreground="{DynamicResource MutedBrush}" LineHeight="11"/>
                </StackPanel>
                <ProgressBar x:Name="HeaderRefresh" Grid.Column="3" Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Refreshing CCS data"/>
                <TextBlock x:Name="VersionText" Grid.Column="4" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>

            <Separator Grid.Row="1"/>

            <Grid Grid.Row="2">
                <StackPanel x:Name="OfflinePanel" Margin="14" Visibility="Collapsed" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar x:Name="StartingProgress" Width="14" Height="14" Margin="0,1,8,0" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Starting CCS"/>
                        <TextBlock x:Name="OfflineTitle" Text="CCS is not running" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="OfflineBody" Text="Start CCS, then the menu will connect automatically." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel x:Name="OfflineActions" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="StartButton" Style="{StaticResource CcsButton.Primary}" Content="Start CCS" Margin="0,0,8,0" Click="Start_Click" AutomationProperties.Name="Start CCS server"/>
                        <Button x:Name="RetryButton" Style="{StaticResource CcsButton.Secondary}" Content="Retry" Click="Retry_Click" AutomationProperties.Name="Retry connection without starting server"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer x:Name="ContentScroll" MaxHeight="780" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="ContentPanel" Margin="14,12"/>
                        <StackPanel x:Name="EmptyState" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="ACCOUNTS" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="EmptyStateText" Text="No accounts configured" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Separator Grid.Row="3"/>
            <Grid x:Name="Footer" Grid.Row="4" Margin="14,11">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="FooterPrimary" Orientation="Horizontal">
                    <Button Style="{StaticResource CcsButton.FooterIcon}" Content="Dashboard" Margin="0,0,12,0" Click="Dashboard_Click" AutomationProperties.Name="Open CCS Dashboard"/>
                    <Button Style="{StaticResource CcsButton.FooterIcon}" Content="Icon" Margin="0,0,12,0" Click="Icon_Click" ToolTip="Toggle tray icon style" AutomationProperties.Name="Toggle tray icon style"/>
                    <Button Style="{StaticResource CcsButton.FooterIcon}" Content="Settings" Click="Settings_Click" AutomationProperties.Name="Open CCS Bar settings"/>
                </StackPanel>
                <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Width="1" Height="1" Opacity="0" AutomationProperties.LiveSetting="Polite"/>
                    <Button Style="{StaticResource CcsButton.FooterIcon}" Content="↻" Margin="0,0,12,0" ToolTip="Refresh" Click="Refresh_Click" AutomationProperties.Name="Force refresh CCS data"/>
                    <Button x:Name="QuitButton" Style="{StaticResource CcsButton.FooterIcon}" Content="Power" ToolTip="Quit CCS Bar (click again to confirm)" Click="Quit_Click" AutomationProperties.Name="Quit CCS Bar"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
