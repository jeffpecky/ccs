<Window x:Class="CCSBar.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCS Bar" Width="360" SizeToContent="Height" MaxHeight="900" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="IconButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MaxHeight="760"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="14,11"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/HeaderLogo.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/><StackPanel><TextBlock Text="CCS Bar" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="↻" FontSize="18" ToolTip="Force refresh" Click="Refresh_Click"/>
            </Grid>
            <Separator Grid.Row="1"/>
            <Grid Grid.Row="2">
                <StackPanel x:Name="OfflinePanel" Margin="18,26" Visibility="Collapsed"><TextBlock x:Name="OfflineTitle" Text="CCS is offline" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="OfflineBody" Text="Start CCS to load accounts and usage." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,12"/><Button x:Name="RetryButton" Content="Start CCS" HorizontalAlignment="Center" Click="Retry_Click"/></StackPanel>
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContentPanel" Margin="14,12"/></ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Content="Dashboard" Click="Dashboard_Click"/><Button Style="{StaticResource IconButton}" Content="Settings" Click="Settings_Click"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UpdateButton" Style="{StaticResource IconButton}" Content="Update" Visibility="Collapsed" Click="Update_Click"/><Button Style="{StaticResource IconButton}" Content="↻" ToolTip="Refresh" Click="Refresh_Click"/><Button x:Name="QuitButton" Style="{StaticResource IconButton}" Content="Power" ToolTip="Quit CCS Bar (click again to confirm)" Click="Quit_Click"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
