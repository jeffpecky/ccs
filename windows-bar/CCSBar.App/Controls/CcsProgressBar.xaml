<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="CcsProgressBar.ControlTemplate" TargetType="ProgressBar">
        <Grid SnapsToDevicePixels="True">
            <Border Background="{DynamicResource TrackBrush}" CornerRadius="100"/>
            <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="100"
                        HorizontalAlignment="Left"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style x:Key="CcsProgressBarTemplate" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="Template" Value="{StaticResource CcsProgressBar.ControlTemplate}"/>
    </Style>

    <Style x:Key="CcsProgressBar.Quota" TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBarTemplate}">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Width" Value="110"/>
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
    </Style>
    <Style x:Key="CcsProgressBar.QuotaBinding" TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBar.Quota}">
        <Setter Property="Height" Value="7"/>
    </Style>
    <Style x:Key="CcsProgressBar.RowGauge" TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBarTemplate}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Width" Value="54"/>
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
    </Style>
    <Style x:Key="CcsProgressBar.Indeterminate" TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBarTemplate}"/>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBarTemplate}"/>
</ResourceDictionary>
