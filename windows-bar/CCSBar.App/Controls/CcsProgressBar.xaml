<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         CCS PROGRESS BAR - Replaces stock ProgressBar chrome
         Matches macOS quota gauge (BarSubscriptionCard:146-152, QuotaGaugeView:876-887):
         - Capsule track (infinite radius)
         - Track: Color.primary.opacity(0.12) → TrackBrush
         - Fill: themed band color (green/amber/coral/red)
         - Height: 5 (normal) or 7 (binding window)
         - Width: 110 (quota bars) or 54 (row gauge)
         ============================================================ -->

    <!-- Quota Bar (110 wide, 5/7 high) - used in subscription cards -->
    <Style x:Key="CcsProgressBar.Quota" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Width" Value="110"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="MaxWidth" Value="110"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <!-- Track -->
                        <Border x:Name="Track"
                                Background="{DynamicResource TrackBrush}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <!-- Fill -->
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0" CenterX="0" CenterY="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="Fill" Property="Width" Value="2"/> <!-- Minimum visible width -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Binding Window Quota Bar (7 high, bold) -->
    <Style x:Key="CcsProgressBar.QuotaBinding" TargetType="ProgressBar" BasedOn="{StaticResource CcsProgressBar.Quota}">
        <Setter Property="Height" Value="7"/>
    </Style>

    <!-- Row Gauge (54 wide, 6 high) - used in BarRowView -->
    <Style x:Key="CcsProgressBar.RowGauge" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Width" Value="54"/>
        <Setter Property="MinWidth" Value="54"/>
        <Setter Property="MaxWidth" Value="54"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Background="{DynamicResource TrackBrush}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0" CenterX="0" CenterY="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Value" Value="0">
                            <Setter TargetName="Fill" Property="Width" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic Progress Bar (for update/install progress) -->
    <Style x:Key="CcsProgressBar.Generic" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Background="{DynamicResource TrackBrush}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0" CenterX="0" CenterY="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mini Progress (for footer refresh spinner) -->
    <Style x:Key="CcsProgressBar.Mini" TargetType="ProgressBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Width="12" Height="12" SnapsToDevicePixels="True">
                        <Ellipse x:Name="Track"
                                 Stroke="{DynamicResource TrackBrush}"
                                 StrokeThickness="2"
                                 SnapsToDevicePixels="True"/>
                        <Ellipse x:Name="Fill"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="2"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5"
                                 SnapsToDevicePixels="True">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                           From="0" To="360"
                                                           Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!-- Default ProgressBar style -->
    <Style x:Key="CcsProgressBarTemplate" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Background="{DynamicResource TrackBrush}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="100"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="0"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0" CenterX="0" CenterY="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>