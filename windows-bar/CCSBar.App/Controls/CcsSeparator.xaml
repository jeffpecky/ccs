<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         CCS SEPARATOR - Replaces stock Separator chrome
         Matches macOS Divider():
         - 1px hairline
         - BorderBrush color
         - Full width
         ============================================================ -->

    <Style x:Key="CcsSeparatorTemplate" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical Separator -->
    <Style x:Key="CcsSeparator.Vertical" TargetType="Separator" BasedOn="{StaticResource CcsSeparatorTemplate}">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="90"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>