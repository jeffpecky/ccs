<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:CCSBar.App.Controls">

    <!-- Orientation to Visibility Converter -->
    <local:OrientationToVisibilityConverter x:Key="OrientationToVisibility"/>

    <!-- ============================================================
         CCS SCROLL BAR - Replaces stock ScrollBar chrome
         Matches macOS NSScroller (overlay style):
         - Thin track (6px)
         - Rounded thumb
         - Hidden until hover (overlay behavior)
         - Accent color thumb
         ============================================================ -->

    <!-- ScrollBar Track -->
    <Style x:Key="CcsScrollBarTrack" TargetType="Track">
        <Setter Property="IsDirectionReversed" Value="False"/>
    </Style>

    <!-- Vertical ScrollBar Thumb -->
    <Style x:Key="CcsScrollBarThumbVertical" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Margin="1,0"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ThumbBorder" Property="Margin" Value="0"/>
                            <Setter TargetName="ThumbBorder" Property="Width" Value="8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ThumbBorder" Property="Width" Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal ScrollBar Thumb -->
    <Style x:Key="CcsScrollBarThumbHorizontal" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Margin="0,1"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ThumbBorder" Property="Margin" Value="0"/>
                            <Setter TargetName="ThumbBorder" Property="Height" Value="8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="ThumbBorder" Property="Height" Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hidden RepeatButtons for line up/down/left/right -->
    <Style x:Key="CcsScrollBarRepeatButton" TargetType="RepeatButton">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main ScrollBar style -->
    <Style x:Key="CcsScrollBarTemplate" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="GridRoot" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vertical Track -->
                        <Track x:Name="VerticalTrack"
                               Grid.Row="1"
                               Grid.Column="1"
                               IsDirectionReversed="True"
                               Style="{StaticResource CcsScrollBarTrack}"
                               Visibility="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OrientationToVisibility}, ConverterParameter=Vertical}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CcsScrollBarThumbVertical}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Style="{StaticResource CcsScrollBarRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Style="{StaticResource CcsScrollBarRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                        </Track>

                        <!-- Horizontal Track -->
                        <Track x:Name="HorizontalTrack"
                               Grid.Row="1"
                               Grid.Column="1"
                               IsDirectionReversed="False"
                               Style="{StaticResource CcsScrollBarTrack}"
                               Visibility="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OrientationToVisibility}, ConverterParameter=Horizontal}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource CcsScrollBarThumbHorizontal}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineRightCommand" Style="{StaticResource CcsScrollBarRepeatButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineLeftCommand" Style="{StaticResource CcsScrollBarRepeatButton}"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer that uses custom scrollbars -->
    <Style x:Key="CcsScrollViewerTemplate" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Column="0"
                                                Grid.Row="0"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Style="{StaticResource CcsScrollBarTemplate}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{Binding ViewportHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                   Maximum="{Binding ScrollableHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                   Minimum="0"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Column="0"
                                   Grid.Row="1"
                                   Style="{StaticResource CcsScrollBarTemplate}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{Binding ViewportWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   Maximum="{Binding ScrollableWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   Minimum="0"/>

                        <!-- Corner filler -->
                        <Border Grid.Column="1" Grid.Row="1" Background="Transparent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>