<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:win="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!-- ============================================================
         CCS MENU ITEM - Replaces stock MenuItem chrome
         Matches macOS NSMenuItem appearance:
         - Clean text, accent highlight on hover
         - Submenu indicator (chevron)
         - Separator support
         - Icon support (checkmark for checked items)
         ============================================================ -->

    <!-- MenuItem style -->
    <Style x:Key="CcsMenuItemTemplate" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.UI}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="IconColumn"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutColumn"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowColumn"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon / Checkmark -->
                            <Grid x:Name="IconGrid"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,8,0"
                                  Visibility="Collapsed">
                                <Path x:Name="CheckMark"
                                      Data="M0,8 L5,13 L14,2"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Margin="2"
                                      Visibility="Collapsed"/>
                                <ContentPresenter x:Name="IconContent"
                                                  Visibility="Collapsed"/>
                            </Grid>

                            <!-- Header -->
                            <ContentPresenter x:Name="HeaderPresenter"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>

                            <!-- Input Gesture / Shortcut -->
                            <TextBlock x:Name="InputGestureText"
                                       Grid.Column="2"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="{DynamicResource FontSize.Caption2}"
                                       FontFamily="{DynamicResource FontFamily.Mono}"
                                       Text="{TemplateBinding InputGestureText}"
                                       Visibility="Collapsed"/>

                            <!-- Submenu Arrow -->
                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="3"
                                  Data="M0,0 L4,4 L0,8"
                                  Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="12,0,4,0"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Has Icon -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGrid" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Static Member=win:DependencyProperty.UnsetValue}">
                            <Setter TargetName="IconGrid" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconContent" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconGrid" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Has Submenu -->
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Input Gesture -->
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="InputGestureText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="{x:Null}">
                            <Setter TargetName="InputGestureText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Hover / Highlight -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Border" Property="Opacity" Value="0.15"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="SubmenuArrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="InputGestureText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Stroke" Value="White"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Separator MenuItem -->
    <Style x:Key="CcsMenuItem.Separator" TargetType="MenuItem" BasedOn="{StaticResource CcsMenuItemTemplate}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                            Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="0,4"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu style (uses CcsMenuItem) -->
    <Style x:Key="CcsContextMenuTemplate" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource PanelShadow}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>