<Window x:Class="CCSBar.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCS Bar Settings" Width="460" Height="600" MinWidth="420" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <!-- Segmented picker (.pickerStyle(.segmented)) built from Ccs tokens;
             no stock RadioButton chrome. -->
        <Style x:Key="CcsSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.UI}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource CcsFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" Background="Transparent" CornerRadius="4" Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource TrackBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: bell.badge in accent + headline (BarPreferencesView.header) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10">
            <TextBlock Text="&#xE7ED;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" AutomationProperties.Name="Alerts and glance"/>
            <TextBlock Text="Alerts &amp; Glance" FontSize="{DynamicResource FontSize.Headline}" FontWeight="{DynamicResource FontWeight.Semibold}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Separator Grid.Row="1"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12">

                <!-- Appearance -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Appearance" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Menu bar theme" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="2">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="SystemSegment" Content="System" GroupName="CcsAppearance" Style="{StaticResource CcsSegment}" Checked="Segment_Changed" AutomationProperties.Name="System appearance"/>
                                    <RadioButton x:Name="LightSegment" Content="Light" GroupName="CcsAppearance" Style="{StaticResource CcsSegment}" Checked="Segment_Changed" AutomationProperties.Name="Light appearance"/>
                                    <RadioButton x:Name="DarkSegment" Content="Dark" GroupName="CcsAppearance" Style="{StaticResource CcsSegment}" Checked="Segment_Changed" AutomationProperties.Name="Dark appearance"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Menu-bar glance -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Menu-bar glance" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Show in menu bar" Margin="0,0,0,6"/>
                            <ComboBox x:Name="GlanceBox" SelectionChanged="Save_Changed" AutomationProperties.Name="Show in menu bar">
                                <ComboBoxItem Content="Auto (smart)"/>
                                <ComboBoxItem Content="Today's spend"/>
                                <ComboBoxItem Content="This month's spend"/>
                                <ComboBoxItem Content="Lowest quota"/>
                                <ComboBoxItem Content="Active account count"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Updates" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12,10">
                        <CheckBox x:Name="AutoUpdates" Content="Check for CCS Bar updates automatically" Click="Save_Changed"/>
                    </Border>
                </StackPanel>

                <!-- Quota -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Quota" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="QuotaEnabled" Content="Alert on low quota" Click="Save_Changed"/>
                            <Grid x:Name="LevelsRow" Margin="24,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Levels (%)" VerticalAlignment="Center"/>
                                <TextBox x:Name="QuotaLevels" Grid.Column="1" Width="120" HorizontalContentAlignment="Right"
                                         ToolTip="Comma-separated remaining percentages" LostFocus="QuotaLevels_LostFocus" KeyDown="Field_KeyDown"
                                         AutomationProperties.Name="Quota alert levels"/>
                            </Grid>
                            <TextBlock Text="Fires once per account at the most-severe level crossed, then again after the next quota reset."
                                       FontSize="{DynamicResource FontSize.Caption2}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Opt-in spend caps: pool accounts only, subscriptions are flat-rate -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Opt-in · pay-per-use spend" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="DailyEnabled" Content="Daily spend cap (pool accounts)" Click="Save_Changed"/>
                            <Grid x:Name="DailyCapRow" Margin="24,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Daily cap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="$" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="DailyCap" Width="90" HorizontalContentAlignment="Right" LostFocus="Cap_LostFocus" KeyDown="Field_KeyDown" AutomationProperties.Name="Daily cap dollars"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="MonthEnabled" Content="Monthly spend cap (pool accounts)" Click="Save_Changed" Margin="0,10,0,0"/>
                            <Grid x:Name="MonthCapRow" Margin="24,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Month cap" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="$" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="MonthCap" Width="90" HorizontalContentAlignment="Right" LostFocus="Cap_LostFocus" KeyDown="Field_KeyDown" AutomationProperties.Name="Monthly cap dollars"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Subscriptions are flat-rate and unaffected. These caps only watch metered pay-per-use pool spend, and are off until you enable them."
                                       FontSize="{DynamicResource FontSize.Caption2}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="24,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Account state -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Account state" FontSize="{DynamicResource FontSize.SectionLabel}" FontWeight="{DynamicResource FontWeight.Bold}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Medium}" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="ReauthEnabled" Content="Alert when an account needs re-auth" Click="Save_Changed"/>
                            <CheckBox x:Name="PausedEnabled" Content="Alert when an account is paused / cooling down" Click="Save_Changed" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Always-present delivery note (BarPreferencesView.deliveryHint) -->
                <StackPanel Orientation="Horizontal" Margin="2,0,2,4">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"/>
                    <TextBlock Text="Alerts show as system notifications when allowed (System Settings › Notifications) and always appear in the menu's Alerts list."
                               FontSize="{DynamicResource FontSize.Caption2}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="6,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Separator Grid.Row="3"/>

        <!-- Footer: Done commits pending edits and closes (BarPreferencesView.footer) -->
        <Grid Grid.Row="4" Margin="14,11">
            <Button x:Name="DoneButton" Content="Done" Style="{StaticResource CcsButton.Primary}" HorizontalAlignment="Right" IsDefault="True" Click="Done_Click" AutomationProperties.Name="Done"/>
        </Grid>
    </Grid>
</Window>
